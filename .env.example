# PostgreSQL Database Credentials (used by docker-compose)
DB_USER=carhub_admin
DB_PASSWORD=change_this_to_a_secure_password
DB_NAME=carhub_os

# JWT Secret for local docker compose interpolation
JWT_SECRET=change_this_to_a_long_random_secret

# Optional Supabase Vault Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
