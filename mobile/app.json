{
  "expo": {
    "name": "Fider",
    "slug": "fider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fider",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121110"
    },
    "ios": {
      "bundleIdentifier": "codes.carhub.fider",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Fider utilise votre appareil photo pour photographier l'état des véhicules lors des états des lieux contradictoires et pour scanner les QR codes locataires.",
        "NSPhotoLibraryUsageDescription": "Fider accède à votre galerie pour vous permettre de joindre des documents de véhicules ou des photos d'état des lieux."
      }
    },
    "android": {
      "package": "codes.carhub.fider",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121110"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Fider utilise l'appareil photo pour inspecter les véhicules et enregistrer les dommages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fider accède à vos photos pour joindre des pièces justificatives."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://www.carhub.codes/api",
      "eas": {
        "projectId": "fider-mobility-prod-2026"
      }
    }
  }
}
