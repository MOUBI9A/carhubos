# CarHubOS backend container for Vercel Services.
# The backend requires Chromium for Puppeteer PDF generation, so a container
# keeps runtime dependencies and system libraries together instead of relying
# on serverless file tracing.

FROM node:22-bookworm-slim AS builder
WORKDIR /app
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN apt-get update && apt-get install -y openssl --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci
COPY . .
RUN npx prisma generate
RUN npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PUPPETEER_SKIP_DOWNLOAD=true

# System Chromium + fonts required by the PDF engine (including Arabic/CJK
# fallback coverage). OpenSSL is required by the Prisma query engine.
# Vercel injects PORT for the container at runtime.
RUN apt-get update && apt-get install -y \
    openssl \
    chromium \
    fonts-ipafont-gothic fonts-wqy-zenhei fonts-thai-tlwg fonts-kacst fonts-freefont-ttf libxss1 \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

COPY --from=builder /app/package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma

EXPOSE 5406
STOPSIGNAL SIGTERM

# Run Node directly instead of through npm. Vercel sends SIGTERM when a
# container is scaled down; npm treats that signal as a failed command and
# reports exit code 1 even when the application is shutting down normally.
# Keeping Node as PID 1 also lets Nest receive the lifecycle signal directly.
# Keep this direct entrypoint so platform scale-down remains a clean lifecycle event.
CMD ["node", "dist/main"]
