# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/carhub_os?schema=public"

# TWILIO CONFIG (WhatsApp Pulse)
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Security — generate a strong random value, e.g. `openssl rand -base64 48`
JWT_SECRET="CHANGE_ME_use_a_long_random_secret"
ALLOWED_ORIGINS="http://localhost:3002"

# Application
PORT=5406
NODE_ENV=development

IDENTITY_PEPPER=change-me-in-production

# AI Vision
# No real CV provider is connected yet. `simulation` enables the clearly-labelled
# preview only; production defaults to `disabled` when this variable is unset.
AI_VISION_MODE=simulation

# VAULT (Supabase Storage) — dormant until set; POST /vault/files/* throws a
# clear "not configured" error rather than silently no-op'ing without these.
# Prefer Supabase's modern server-only secret key (`sb_secret_...`). It bypasses
# RLS, so never expose it to browser/client code or commit it to source control.
# The legacy service_role key remains supported temporarily for migration only.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_your_server_key"
# SUPABASE_SERVICE_ROLE_KEY="legacy_service_role_key"
SUPABASE_VAULT_BUCKET="vault-files"

# PAYMENTS — PAYMENT_PROVIDER selects the active gateway.
# - Local/dev may use MOCK.
# - Production refuses MOCK.
# - Use DISABLED for a production pilot that does not process online payments yet;
#   checkout/webhook endpoints return 503 and no settlement can occur.
# - Use STRIPE/CMI only after the real provider is configured.
# Prefer a restricted Stripe key (rk_test_/rk_live_) scoped to Checkout Sessions
# (write) + Webhook Endpoints (read) over the full secret key. Get
# STRIPE_WEBHOOK_SECRET from `stripe listen --forward-to <host>/api/payments/webhooks/stripe`
# locally, or the Dashboard's webhook endpoint config in production.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
