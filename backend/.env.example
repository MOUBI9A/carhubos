# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/carhub_os?schema=public"

# TWILIO CONFIG (WhatsApp Pulse)
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Security — generate a strong random value, e.g. `openssl rand -base64 48`
JWT_SECRET="CHANGE_ME_use_a_long_random_secret"
ALLOWED_ORIGINS="http://localhost:3002"

# Application
PORT=5406
NODE_ENV=development

IDENTITY_PEPPER=change-me-in-production
