// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 🏛️ PILLAR 1: SAAS CORE & MULTI-TENANCY
model Agency {
  id               String    @id @default(uuid())
  name             String
  subdomain        String?   @unique
  city             String    @default("Casablanca")
  address          String? // Official headquarters
  taxId            String? // ICE / Patent Number
  logoUrl          String? // Cloud storage URL
  contactEmail     String    @unique
  businessPhone    String?
  website          String? // Public site shown on the settings page + landing profile
  plan             String    @default("PILOT") // PILOT, GROWTH, ENTERPRISE
  subscriptionStatus String  @default("ACTIVE") // TRIAL, ACTIVE, PAST_DUE, CANCELED
  trialEndsAt      DateTime?
  subscriptionStartedAt DateTime?
  subscriptionEndsAt DateTime?
  billingEmail     String?
  monthlyPriceCents Int      @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users            User[]
  cars             Car[]
  customers        Customer[]
  bookings         Booking[]
  invoices         Invoice[]
  payments         Payment[]
  expenses         Expense[]
  documents        Document[]
  tasks            Task[]
  inspections      Inspection[]
  accidents        Accident[]
  waitlistEntries  WaitlistEntry[]
  blacklistEntries BlacklistEntry[]
  vaultFiles       VaultFile[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  automationRules  AutomationRule[]
  automationExecutions AutomationExecution[]
  b2bListings      B2BListing[]
  b2bRequests      B2BRequest[]
  trustReviews     TrustReview[]
  trustLookups     TrustLookup[]
  consentGrants    ConsentGrant[]
}

model User {
  id           String   @id @default(uuid())
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("AGENT") // ROOT_ADMIN, OWNER, MANAGER, AGENT, RENTER
  isActive     Boolean  @default(true)
  capabilities Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")
  inspections   Inspection[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model Car {
  id            String   @id @default(uuid())
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  brand         String
  model         String
  year          Int
  licensePlate  String
  vin           String?
  fuelType      String   @default("DIESEL")
  transmission  String   @default("MANUAL")
  dailyRateCents Int
  status        String   @default("AVAILABLE") // AVAILABLE, RENTED, MAINTENANCE, OUT_OF_SERVICE
  mileageKm     Int      @default(0)
  color         String?
  imageUrl      String?
  purchasePriceCents Int?
  purchaseDate  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings      Booking[]
  documents     Document[]
  inspections   Inspection[]
  accidents     Accident[]
  b2bListings   B2BListing[]

  @@unique([agencyId, licensePlate])
  @@index([agencyId, status])
}

model Customer {
  id             String   @id @default(uuid())
  agencyId       String
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  phone          String
  email          String?
  idType         String   @default("CIN")
  idNumberHash   String?
  idLast4        String?
  nationality    String?
  isBlacklisted  Boolean  @default(false)
  blacklistReason String?
  trustScore     Int?
  trustReviewCount Int    @default(0)
  trustRiskLevel String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings       Booking[]
  waitlistEntries WaitlistEntry[]
  blacklistEntries BlacklistEntry[]
  trustReviews   TrustReview[]
  consentGrants  ConsentGrant[]

  @@unique([agencyId, phone])
  @@index([agencyId, isBlacklisted])
}

model Booking {
  id                 String   @id @default(uuid())
  agencyId           String
  agency             Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  carId               String
  car                 Car      @relation(fields: [carId], references: [id])
  customerId          String
  customer            Customer @relation(fields: [customerId], references: [id])
  startDate           DateTime
  endDate             DateTime
  dailyRateCents      Int
  subtotalCents       Int
  taxCents            Int      @default(0)
  totalCents          Int
  depositCents        Int      @default(0)
  depositStatus       String   @default("PENDING") // PENDING, HELD, RETURNED, CLAIMED
  depositMethod       String?
  damageChargeCents   Int      @default(0)
  status              String   @default("REQUESTED") // REQUESTED, APPROVED, ACTIVE, OVERDUE, COMPLETED, CANCELLED
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  invoice              Invoice?
  payments             Payment[]
  inspections          Inspection[]
  accidents            Accident[]
  trustReviews         TrustReview[]

  @@index([agencyId, startDate, endDate])
  @@index([carId, startDate, endDate])
  @@index([customerId])
}

model Invoice {
  id            String   @id @default(uuid())
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  invoiceNumber String
  subtotalCents Int
  taxCents      Int
  totalCents    Int
  paidCents     Int      @default(0)
  status        String   @default("DUE") // DUE, PARTIAL, PAID, VOID
  issuedAt      DateTime @default(now())
  dueAt         DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments      Payment[]

  @@unique([agencyId, invoiceNumber])
  @@index([agencyId, status])
}

model Payment {
  id           String   @id @default(uuid())
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingId    String?
  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoiceId    String?
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  type         String   @default("INCOME") // INCOME, REFUND
  method       String   @default("CASH") // CASH, CARD, TRANSFER, CHEQUE, ONLINE
  amountCents  Int
  status       String   @default("PENDING") // PENDING, VERIFIED, FAILED, REFUNDED
  reference    String?
  provider     String?
  providerRef  String?
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agencyId, status])
  @@index([invoiceId])
}

model Expense {
  id          String   @id @default(uuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  category    String
  amountCents Int
  memo        String?
  spentAt     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencyId, spentAt])
}

model Document {
  id           String   @id @default(uuid())
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  carId        String
  car          Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  type         String
  fileUrl      String?
  issuedAt     DateTime?
  expiresAt    DateTime
  status       String   @default("VALID") // VALID, EXPIRING, EXPIRED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agencyId, expiresAt])
  @@index([carId, type])
}

model Task {
  id          String   @id @default(uuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  title       String
  details     String?
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueAt       DateTime?
  assignedToId String?
  assignedTo  User?    @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencyId, status])
}

model Inspection {
  id          String   @id @default(uuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  carId       String
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  type        String
  status      String   @default("PENDING") // PENDING, COMPLETED
  fuelLevel   Int?
  mileageKm   Int?
  damageNotes String?
  photos      Json?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencyId, carId])
}

model Accident {
  id                 String   @id @default(uuid())
  agencyId           String
  agency             Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  carId               String
  car                 Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  bookingId           String?
  booking             Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  occurredAt          DateTime
  severity            String   @default("MINOR") // MINOR, MODERATE, MAJOR, TOTAL_LOSS
  description         String
  location            String?
  thirdPartyInvolved  Boolean  @default(false)
  estimatedCostCents  Int?
  status              String   @default("OPEN") // OPEN, INVESTIGATING, CLAIM_FILED, RESOLVED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([agencyId, status])
  @@index([carId, occurredAt])
}

model WaitlistEntry {
  id               String   @id @default(uuid())
  agencyId         String
  agency           Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  phone            String?
  desiredTier      String?
  opportunityCents Int      @default(0)
  status           String   @default("OPEN") // OPEN, RECOVERED, LOST
  recoveredBookingId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([agencyId, status])
}

model BlacklistEntry {
  id          String   @id @default(uuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason      String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agencyId, customerId])
  @@index([agencyId, active])
}

model VaultFile {
  id          String   @id @default(uuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name        String
  storagePath String
  mimeType    String
  sizeBytes   Int
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencyId, createdAt])
  @@unique([agencyId, storagePath])
}

model AuditLog {
  id         String   @id @default(uuid())
  agencyId   String?
  agency     Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([agencyId, createdAt])
}

model Notification {
  id         String   @id @default(uuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([userId, readAt])
}

model AutomationRule {
  id          String   @id @default(uuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name        String
  trigger     String
  action      String
  config      Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions AutomationExecution[]

  @@index([agencyId, isActive])
}

model AutomationExecution {
  id          String   @id @default(uuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  ruleId      String
  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  status      String   @default("SUCCESS") // SUCCESS, FAILED
  details     Json?
  executedAt  DateTime @default(now())

  @@index([agencyId, executedAt])
}

model B2BListing {
  id             String   @id @default(uuid())
  agencyId       String
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  carId          String
  car            Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  dailyRateCents Int
  isActive       Boolean  @default(true)
  availableFrom  DateTime?
  availableTo    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requests B2BRequest[]

  @@index([agencyId, isActive])
  @@index([carId, isActive])
}

model B2BRequest {
  id              String   @id @default(uuid())
  listingId       String
  listing         B2BListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requestingAgencyId String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  startDate       DateTime
  endDate         DateTime
  message         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([listingId, status])
  @@index([requestingAgencyId, status])
}

model TrustReview {
  id          String   @id @default(uuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([agencyId, createdAt])
}

model TrustLookup {
  id             String   @id @default(uuid())
  agencyId       String
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  identityHash   String
  outcome        String?
  createdAt      DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([identityHash])
}

model ConsentGrant {
  id          String   @id @default(uuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  scope       Json
  status      String   @default("PENDING") // PENDING, APPROVED, REVOKED, EXPIRED
  expiresAt   DateTime?
  approvedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencyId, customerId, status])
}
